# Preloads scripts/sandbox-no-wasm.cjs into every Node process npm starts.
#
# The shim is self-disabling: it first probes whether WebAssembly memory can be
# allocated and leaves Node completely untouched when it can. It only kicks in on
# hosts where V8 cannot reserve wasm memory (see the header comment of that file),
# which is what Vite's bundled es-module-lexer depends on at build time.
node-options=--require ./scripts/sandbox-no-wasm.cjs

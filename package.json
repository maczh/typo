{
  "name": "typo",
  "version": "0.1.0",
  "private": true,
  "description": "Typo - A Typora-style WYSIWYG Markdown editor built with Tauri v2 + Vue3 + Milkdown",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && node scripts/prepare-build.cjs && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@milkdown/core": "^7.0.0",
    "@milkdown/crepe": "^7.0.0",
    "@milkdown/preset-commonmark": "^7.0.0",
    "@milkdown/preset-gfm": "^7.0.0",
    "@milkdown/prose": "^7.0.0",
    "@milkdown/theme-nord": "^7.0.0",
    "@milkdown/transformer": "^7.0.0",
    "@milkdown/utils": "^7.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "docx": "^8.0.0",
    "highlight.js": "^11.9.0",
    "jsdom": "^30.1.2",
    "katex": "^0.16.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^10.0.0",
    "pinia": "^2.1.0",
    "rehype-highlight": "^7.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "unified": "^11.0.0",
    "vue": "^3.4.0",
    "vue-i18n": "^9.13.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "terser": "^5.51.2",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0"
  }
}
